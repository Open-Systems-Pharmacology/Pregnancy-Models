      <Builders>
        <TransportBuilder id="u2x85izGw0q9IKIdbl5low" name="PassiveDiffusionPlacentaBarrier" description="Passive transport based on Dallmann et al. 2017 &#xD;&#xA;" icon="TRANSPORT" mode="Logical" containerType="Other" dimension="Amount per time" createProcessRateParameter="0" processRateParameterPersistable="0" formula="GryHk2Qz7kqvSaK6W8CISQ" transportType="0">
          <SourceCriteria operator="And">
            <DescriptorConditions>
              <MatchTagCondition tag="Plasma" />
              <MatchTagCondition tag="PlacentaMaternal" />
            </DescriptorConditions>
          </SourceCriteria>
          <TargetCriteria operator="And">
            <DescriptorConditions>
              <MatchTagCondition tag="Intracellular" />
              <MatchTagCondition tag="PlacentaFetal" />
            </DescriptorConditions>
          </TargetCriteria>
          <MoleculeList forAll="1" />
        </TransportBuilder>
      </Builders>
