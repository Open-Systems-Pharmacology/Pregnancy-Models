        <CoreCalculationMethod id="c8FdyeoE3U284tGRosn3gw" name="Interstitial partition coefficient method - Schmitt" icon="CoreCalculationMethod" bbVersion="0" category="DistributionInterstitial">
          <Creation createdAt="5250278556870540228" createdBy="mcint" creationMode="New" origin="Other" />
          <OutputFormulas>
            <KeyValue>
              <Formula id="Interstitial partition coefficient method - Schmitt.PARAM_K_int_pls" name="PARAM_K_int_pls" formula="(f_water_int + f_proteins_int_to_pls * (1/fu - f_water_pls)) * fu">
                <Paths>
                  <Path path="0" as="1" dim="2" />
                  <Path path="3" as="4" />
                  <Path path="5" as="6" />
                  <Path path="7" as="8" />
                </Paths>
              </Formula>
              <ParameterDescriptor parameterName="Partition coefficient (interstitial/plasma)">
                <ContainerCriteria operator="And">
                  <DescriptorConditions>
                    <MatchTagCondition tag="Neighborhood: Plasma / Interstitial" />
                  </DescriptorConditions>
                </ContainerCriteria>
              </ParameterDescriptor>
            </KeyValue>
          </OutputFormulas>
          <HelpParameters>
            <KeyValue>
              <Parameter id="K-w01rtMKUGrdBV4WF2-Yg" name="Partition coefficient (interstitial/water)" icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" formula="Interstitial partition coefficient method - Schmitt.PARAM_K_water_int_Schmitt" isDefault="1">
                <Info min="0" flag="52" seq="1" ref="0" bb="2" group="143" />
