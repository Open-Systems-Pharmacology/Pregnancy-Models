                    <SumFormula id="D2GHQTUWt0emo6QErLPihw" name="PARAM_Blood_Organs_Weight" dim="Mass" variable="P" formulaString="P_#i">
                      <Criteria operator="And">
                        <DescriptorConditions>
                          <MatchTagCondition tag="BloodOrgan" />
                          <MatchTagCondition tag="Weight (tissue)" />
                          <NotInContainerCondition tag="Fetus" />
                        </DescriptorConditions>
                      </Criteria>
                    </SumFormula>
                    <SumFormula id="HKTfs7It1EC259T5oG-RJw" name="PARAM_VolumePlasma" dim="Volume" variable="V" formulaString="V_#i">
                      <Criteria operator="And">
                        <DescriptorConditions>
                          <InContainerCondition tag="Plasma" />
                          <MatchTagCondition tag="Volume" />
                          <NotInContainerCondition tag="Pericentral" />
                          <NotInContainerCondition tag="Periportal" />
                          <NotInContainerCondition tag="EndogenousIgG" />
                          <NotInContainerCondition tag="Fetus" />
                        </DescriptorConditions>
                      </Criteria>
                    </SumFormula>
