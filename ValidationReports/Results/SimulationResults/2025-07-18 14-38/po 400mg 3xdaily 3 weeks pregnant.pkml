      <AllCalculationMethods>
        <CoreCalculationMethod id="rjO1zKvnKU6Xz03x9rHwTA" name="Cellular partition coefficient method - Berezhkovskiy" icon="CoreCalculationMethod" bbVersion="0" category="DistributionCellular">
          <Creation createdAt="5250278556870373555" createdBy="mcint" creationMode="New" origin="Other" />
          <OutputFormulas>
            <KeyValue>
              <Formula id="Cellular partition coefficient method - Berezhkovskiy.PARAM_K_rbc" name="PARAM_K_rbc" formula="(f_water_rbc + f_lipids_rbc * 10^LogMA + f_proteins_rbc * KProt)*fu">
                <Paths>
                  <Path path="0" as="1" dim="2" />
                  <Path path="3" as="4" dim="5" />
                  <Path path="6" as="7" />
                  <Path path="8" as="9" />
                  <Path path="10" as="11" />
                  <Path path="12" as="13" />
                </Paths>
              </Formula>
              <ParameterDescriptor parameterName="Partition coefficient (blood cells/plasma)">
                <ContainerCriteria operator="And">
                  <DescriptorConditions>
                    <MatchTagCondition tag="RootContainer" />
                  </DescriptorConditions>
                </ContainerCriteria>
              </ParameterDescriptor>
