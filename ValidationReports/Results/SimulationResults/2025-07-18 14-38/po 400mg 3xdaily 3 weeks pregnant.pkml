                        <Info min="0" flag="50" seq="42" ref="0" bb="2" group="19" />
                      </Parameter>
                      <Parameter id="COBiMzw1e0a7XRVLkDNAuA" name="kass (FcRn)" description="Association constant of drug for binding to FcRn" icon="Parameter" persistable="0" isFixedValue="0" dim="Second order rate constant" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="0.87" displayUnit="l/µmol/min">
                        <ValueOrigin id="26" source="Publication" description="Niederalt, C., Kuepfer, L., Solodenko, J. et al. J Pharmacokinet Pharmacodyn (2017). https://doi.org/10.1007/s10928-017-9559-4" />
